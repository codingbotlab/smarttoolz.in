RewriteEngine On

# Block implementation helpers from direct public access.
RewriteRule ^(?:api|lib|analytics|creator-ai)(?:/|$) - [F,L]

# Canonical old PHP tool URL -> clean tool folder.
RewriteCond %{THE_REQUEST} \s/+tools/([A-Za-z0-9-]+)\.php(?:[?\s]) [NC]
RewriteRule ^tools/([A-Za-z0-9-]+)\.php$ /tools/$1/ [R=301,L,NE]

# Clean tool URL -> matching implementation.
RewriteRule ^tools/([A-Za-z0-9-]+)/?$ tools/$1/$1.php [L,QSA,NC]

# Clean category URL -> filtered All Tools page.
RewriteRule ^category/([A-Za-z0-9-]+)/?$ tool.php?category=$1 [L,QSA,NC]

# No legacy /smart-toolz route is part of the new site.
RewriteRule ^smart-toolz(?:/.*)?$ / [R=301,L,NE,NC]

ErrorDocument 404 /404.php
DirectoryIndex index.php

# Basic browser caching for static assets.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
</IfModule>
