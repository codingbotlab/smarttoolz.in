RewriteEngine On

# Canonical old extension URLs -> clean tool folders.
RewriteCond %{THE_REQUEST} \s/+tools/([A-Za-z0-9-]+)\.php(?:[?\s]) [NC]
RewriteRule ^tools/([A-Za-z0-9-]+)\.php$ /tools/$1/ [R=301,L,NE]

# Canonical clean tool URL -> the tool's own implementation file.
RewriteRule ^tools/([A-Za-z0-9-]+)/?$ tools/$1/$1.php [END,QSA,NC]

# Canonical category URLs.
RewriteRule ^category/([A-Za-z0-9-]+)/?$ /tool.php?category=$1 [END,QSA,NC]

# Keep the public root as the homepage.
DirectoryIndex index.php
