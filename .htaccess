RewriteEngine On
Options -MultiViews

# Canonical clean tool URLs.
RewriteCond %{THE_REQUEST} \s/+tools/([A-Za-z0-9-]+)\.php(?:[?\s]) [NC]
RewriteRule ^tools/([A-Za-z0-9-]+)\.php$ /tools/$1/ [R=301,L,NE]
RewriteRule ^tools/([A-Za-z0-9-]+)/?$ tools/$1/$1.php [L,QSA,NC]

# Public XML sitemap for search engines.
RewriteRule ^sitemap\.xml$ sitemap.php [L,QSA]

# Human-friendly sitemap page.
RewriteRule ^sitemap/?$ sitemap/index.php [L,QSA,NC]

# How To Use listing and automatic tool-specific guides.
RewriteRule ^how-to/?$ how-to/list.php [L,QSA,NC]
RewriteRule ^how-to/([a-z0-9]+(?:-[a-z0-9]+)*)/?$ how-to/index.php?slug=$1 [L,QSA,NC]

# Friendly blog listing and article URLs.
RewriteRule ^blog/?$ blog/index.php [L,QSA,NC]
RewriteRule ^blog/([a-z0-9]+(?:-[a-z0-9]+)*)/?$ blog/article.php?slug=$1 [L,QSA,NC]

# Friendly error pages. Keep the original HTTP status code so error URLs
# remain non-indexable and search engines receive the correct response.
ErrorDocument 400 /error.php?code=400
ErrorDocument 401 /error.php?code=401
ErrorDocument 403 /error.php?code=403
ErrorDocument 404 /error.php?code=404
ErrorDocument 405 /error.php?code=405
ErrorDocument 408 /error.php?code=408
ErrorDocument 410 /error.php?code=410
ErrorDocument 413 /error.php?code=413
ErrorDocument 414 /error.php?code=414
ErrorDocument 415 /error.php?code=415
ErrorDocument 416 /error.php?code=416
ErrorDocument 421 /error.php?code=421
ErrorDocument 422 /error.php?code=422
ErrorDocument 423 /error.php?code=423
ErrorDocument 424 /error.php?code=424
ErrorDocument 426 /error.php?code=426
ErrorDocument 428 /error.php?code=428
ErrorDocument 429 /error.php?code=429
ErrorDocument 431 /error.php?code=431
ErrorDocument 451 /error.php?code=451
ErrorDocument 500 /error.php?code=500
ErrorDocument 501 /error.php?code=501
ErrorDocument 502 /error.php?code=502
ErrorDocument 503 /error.php?code=503
ErrorDocument 504 /error.php?code=504
ErrorDocument 505 /error.php?code=505
ErrorDocument 506 /error.php?code=506
ErrorDocument 507 /error.php?code=507
ErrorDocument 508 /error.php?code=508
ErrorDocument 510 /error.php?code=510
ErrorDocument 511 /error.php?code=511

DirectoryIndex index.php
