# SmartToolz secrets/configuration
# Never commit real credentials. Configure these as server environment variables
# (or as a JSON file outside the public web root where a module explicitly supports it).

DB_HOST=localhost
DB_NAME=
DB_USER=
DB_PASS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://smarttoolz.in/creator-ai/auth/google-callback.php
OPENAI_API_KEY=
GEMINI_API_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
REDDOTT_YOUTUBE_CLIENT_ID=
REDDOTT_YOUTUBE_CLIENT_SECRET=
REDDOTT_YOUTUBE_CLIENT_CONFIG=

# Existing modules may have additional provider-specific variables; keep them
# server-side and add their variable names here rather than their values.
