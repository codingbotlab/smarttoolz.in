RewriteEngine On


# ============================================================
# CREATOR AI — REAL FILES / FOLDERS
# ============================================================

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]


# ============================================================
# CREATOR AI TOOLS
# ============================================================

RewriteRule ^ai-writer/?$ tools/ai-writer.php [L]

RewriteRule ^prompt-studio/?$ tools/prompt-studio.php [L]

RewriteRule ^text-case/?$ tools/text-case.php [L]

RewriteRule ^word-counter/?$ tools/word-counter.php [L]

RewriteRule ^json-formatter/?$ tools/json-formatter.php [L]

RewriteRule ^base64/?$ tools/base64.php [L]

RewriteRule ^url-encoder/?$ tools/url-encoder.php [L]

RewriteRule ^slug-generator/?$ tools/slug-generator.php [L]

RewriteRule ^password-generator/?$ tools/password-generator.php [L]

RewriteRule ^color-converter/?$ tools/color-converter.php [L]


# ============================================================
# AUTHENTICATION
# ============================================================

RewriteRule ^login/?$ auth/login.php [L]

RewriteRule ^workspace/?$ auth/dashboard.php [L]

RewriteRule ^logout/?$ auth/logout.php [L]


# ============================================================
# GOOGLE OAUTH
# ============================================================

RewriteRule ^auth/google-login/?$ auth/google-login.php [L]

RewriteRule ^auth/google-callback/?$ auth/google-callback.php [L]


# ============================================================
# CREDITS
# ============================================================

RewriteRule ^credits/?$ credits.php [L]


# ============================================================
# CREATOR AI API
# ============================================================

RewriteRule ^api/create-order/?$ api/create-order.php [L]

RewriteRule ^api/verify-payment/?$ api/verify-payment.php [L]

RewriteRule ^api/razorpay-webhook/?$ api/razorpay-webhook.php [L]