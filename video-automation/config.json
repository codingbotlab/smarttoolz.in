{
  "source_repo": "codingbotlab/smarttoolz.in",
  "knowledge_base_root": "/knowledge-base",
  "generation_root": "/knowledge-base/_generated",
  "video": {
    "long_min_seconds": 180,
    "long_target_seconds": 360,
    "long_max_seconds": 600,
    "short_min_seconds": 30,
    "short_max_seconds": 60,
    "fps": 30,
    "long": { "width": 1920, "height": 1080 },
    "short": { "width": 1080, "height": 1920 }
  },
  "storage": {
    "keep_generation_history": true,
    "published_images_dir": "images",
    "published_long_video_dir": "videos/long",
    "published_short_video_dir": "videos/shorts"
  },
  "safety": {
    "do_not_modify_existing_tool_code": true,
    "require_real_tool_workflow": true,
    "require_quality_gate_before_upload": true,
    "youtube_default_privacy": "private"
  }
}
