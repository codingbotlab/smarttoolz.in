{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": { "contentSize": "820px", "wideSize": "1160px", "fullSize": "none" },
    "color": {
      "custom": true,
      "customGradient": true,
      "defaultPalette": false,
      "palette": [
        { "name": "Primary", "slug": "primary", "color": "#4f46e5" },
        { "name": "Text", "slug": "text", "color": "#101828" },
        { "name": "Muted", "slug": "muted", "color": "#667085" },
        { "name": "Surface", "slug": "surface", "color": "#ffffff" },
        { "name": "Background", "slug": "background", "color": "#f5f7fb" }
      ]
    },
    "spacing": { "blockGap": true, "margin": true, "padding": true, "units": ["%", "px", "em", "rem", "vh", "vw"] },
    "typography": {
      "fluid": true,
      "customFontSize": true,
      "customLineHeight": true,
      "dropCap": false,
      "fontSizes": [
        { "size": "0.8125rem", "name": "Small", "slug": "small" },
        { "size": "1.125rem", "name": "Medium", "slug": "medium" },
        { "size": "2.25rem", "name": "Large", "slug": "large" },
        { "size": "clamp(2.5rem, 6vw, 4.7rem)", "name": "Display", "slug": "display" }
      ]
    },
    "border": { "radius": true, "color": true, "style": true, "width": true },
    "shadow": { "defaultPresets": false, "presets": [ { "name": "Soft", "slug": "soft", "shadow": "0 14px 40px rgba(16,24,40,.08)" } ] }
  },
  "styles": {
    "spacing": { "blockGap": "1.5rem" },
    "typography": { "lineHeight": "1.7" },
    "elements": {
      "link": { "typography": { "textDecoration": "none" } },
      "button": { "border": { "radius": "10px" }, "typography": { "fontWeight": "700" } }
    }
  }
}
